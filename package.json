{
  "name": "joint-venture",
  "private": true,
  "scripts": {
    "install:all": "pnpm install && cd studio && pnpm install",
    "prepare": "is-ci || husky install",
    "build": "npm-run-all --sequential clean generate:* --parallel build:next build:sanity",
    "dev": "npm-run-all --sequential generate:* --parallel dev:*",
    "clean": "rimraf ./public/studio",
    "generate:sanity": "pnpm sanity-codegen",
    "build:next": "next build --debug",
    "build:sanity": "cd studio && sanity build ../public/studio -y && cd ..",
    "dev:next": "next dev",
    "dev:sanity": "cp .env ./studio/.env.development && cd studio && sanity dev",
    "format": "prettier --write .",
    "ngrok": "ngrok http 3000"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@itm-studio/partner-sdk": "^0.2.8",
    "@portabletext/react": "^3.2.4",
    "@portabletext/types": "^2.0.15",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^1.2.0",
    "@sanity/types": "^3.99.0",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "3.6.0",
    "focus-visible": "^5.2.1",
    "framer-motion": "^10.18.0",
    "groq": "^2.36.6",
    "next": "^14.2.35",
    "next-sanity": "^8.5.5",
    "next-sanity-image": "^6.2.0",
    "react": "^18.3.1",
    "react-day-picker": "8.10.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-rough-notation": "^1.0.8",
    "react-scroll": "^1.9.3",
    "react-toastify": "^9.1.3",
    "sanity": "^3.99.0",
    "sharp": "^0.32.6",
    "slugify": "^1.6.9",
    "swiper": "12.1.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@asbjorn/eslint-plugin-groq": "^2.0.0",
    "@next/bundle-analyzer": "^15.5.15",
    "@sanity/cli": "^3.99.0",
    "@types/cors": "^2.8.19",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-scroll": "^1.8.10",
    "@welldone-software/why-did-you-render": "^8.0.3",
    "autoprefixer": "^10.5.0",
    "csstype": "^3.2.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-sanity": "^6.0.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.5.6",
    "husky": "^7.0.4",
    "is-ci": "^3.0.1",
    "lint-staged": "^12.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.13",
    "postcss-focus-visible": "^8.0.2",
    "postcss-hexrgba": "^2.1.0",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^12.1.5",
    "postcss-preset-env": "^8.5.1",
    "prettier": "^2.8.8",
    "rimraf": "^3.0.2",
    "sanity-codegen": "^0.9.8",
    "stylelint": "^14.16.1",
    "stylelint-config-css-modules": "^3.0.0",
    "stylelint-config-standard": "^25.0.0",
    "stylelint-order": "^5.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
