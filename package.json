    "@commitlint/cli": "^16.3.0",
    "@commitlint/config-conventional": "^16.2.4",
    "@commitlint/types": "^16.2.1",
    "@next/bundle-analyzer": "^15.1.7",
    "@sanity/cli": "^3.64.1",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.17.6",
