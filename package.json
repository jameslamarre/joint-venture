    "@sanity/asset-utils": "^2.2.0",
    "@sanity/client": "^6.22.5",
    "@sanity/icons": "^2.11.8",
    "@sanity/image-url": "^1.1.0",
    "@sanity/types": "^3.64.1",
    "@sanity/ui": "^2.8.24",
    "@vercel/analytics": "^1.4.0",
    "@vercel/node": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "focus-visible": "^5.2.1",
    "framer-motion": "^10.18.0",
    "fs": "0.0.1-security",
    "groq": "^2.36.6",
    "next": "^14.2.18",
    "next-sanity": "^8.5.5",
    "next-sanity-image": "^6.1.1",
    "react": "^18.3.1",
    "react-cookie": "^6.1.3",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-is": "^18.3.1",
    "react-rough-notation": "^1.0.8",
    "react-scroll": "^1.9.0",
    "react-toastify": "^9.1.3",
    "react-transition-group": "^4.4.5",
    "sanity": "^3.64.1",
